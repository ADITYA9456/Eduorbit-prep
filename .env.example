NEXTAUTH_SECRET=generate-a-long-random-value
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The Google account allowed to complete admin verification.
ADMIN_EMAIL=admin@example.com
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" "choose-a-password"
ADMIN_PASSWORD_HASH=
# Optional separate signing key; NEXTAUTH_SECRET is used when omitted.
ADMIN_SESSION_SECRET=
