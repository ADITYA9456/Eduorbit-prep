# Auth.js / NextAuth v4 (server-only OAuth credentials)
GOOGLE_CLIENT_ID=your-prep-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-prep-google-oauth-client-secret
NEXTAUTH_SECRET=generate-a-long-random-secret
NEXTAUTH_URL=http://localhost:3000

# Supabase PostgreSQL (the service-role key is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Comma-separated, lower-case administrator email addresses
ADMIN_EMAILS=admin@example.com

